# Slack User Token (xoxp-...) or Bot Token (xoxb-...)
# Required scopes: lists:read, lists:write (optional: users:read, files:read)
SLACK_TOKEN=xoxp-your-token-here

# Optional: Slack App-Level Token (xapp-...) if using Socket Mode
# SLACK_APP_TOKEN=xapp-your-app-token-here

# Default Slack List ID (the F0... ID from your Slack List URL)
SLACK_LIST_ID=F0123456789

# Optional: Name of the select column used to group Kanban board columns (defaults to "Status")
# SLACK_STATUS_COLUMN=Status
